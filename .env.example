# ─────────────────────────────────────────────────────────────────────────────
# 369xchange — Environment Variables
# Copy this file to .env.local for local dev, or paste into your hosting
# provider's environment-variable settings (Netlify / Vercel / Railway etc.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A: Firebase (recommended for production) ──────────────────────────
# Get all values from Firebase Console → Project Settings → Your apps → Web app
# Then enable Google sign-in: Authentication → Sign-in method → Google → Enable
# IMPORTANT: Add every domain you deploy to under:
#   Authentication → Settings → Authorised domains
# (e.g. yourdomain.com, yourapp.netlify.app, localhost)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client ID — required for BOTH Option A and Option B.
# Get it from: Firebase Console → Authentication → Sign-in method → Google
#   → Web SDK configuration → Web client ID
# OR from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# IMPORTANT: Under "Authorised JavaScript origins" add EVERY domain you deploy to.
# (e.g. https://yourdomain.com, https://yourapp.netlify.app, http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Option B: Google-only (no Firebase, simpler setup) ───────────────────────
# Set ONLY NEXT_PUBLIC_GOOGLE_CLIENT_ID above and leave all Firebase vars empty.
# This uses Google Identity Services directly.
# Still requires "Authorised JavaScript origins" to include your deployment URL.
